# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (nếu dùng PostgreSQL sau này)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pharmacy_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Email Settings (để gửi password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# OpenCode Zen API (OCR)
OPENCODEZEN_API_KEY=your-opencodezen-api-key-here
# Optional fallback if you already use the standard OpenAI env var name.
OPENAI_API_KEY=your-openai-api-key-here
OPENCODEZEN_BASE_URL=https://api.opencode.ai/v1
OPENCODEZEN_MODELS=gpt-4o-mini

# Gemini Vision API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-2.0-flash

# Security
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_SECURE=False  
CSRF_COOKIE_SECURE=False
